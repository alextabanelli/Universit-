<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="Alex"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2023-09-21 05:46:36 "/>
        <attribute name="created" value="QWxleDtXMTE7MjAyMy0wOS0yMDsiMTA6NDY6NDcgIjsxNzc0"/>
        <attribute name="edited" value="QWxleDtXMTE7MjAyMy0wOS0yMTsiMDU6MDg6NDYgIjsxO0FsZXg7VzExOzIwMjMtMDktMjA7IjEwOjQ2OjQ3ICI7c29tbWEgZHVlIG51bWVyaSBjb24gY2lmcmUuZnByZzs2NzM3"/>
        <attribute name="edited" value="QWxleDtXMTE7MjAyMy0wOS0yMTsiMDU6NDY6MzYgIjsxMjsxOTM1"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="m, t, cif11, cif12, cif21, cif22, rip, i, n, val, sus, somma" type="Integer" array="False" size=""/>
            <declare name="vect, prod, pro1, pro2" type="Integer" array="True" size="4"/>
            <output expression="&quot;Dammi il primo numero&quot;" newline="True"/>
            <input variable="m"/>
            <output expression="&quot;Dammi il secondo numero&quot;" newline="True"/>
            <input variable="t"/>
            <assign variable="rip" expression="0"/>
            <for variable="i" start="0" end="3" direction="inc" step="1">
                <assign variable="prod[i]" expression="0"/>
                <assign variable="pro1[i]" expression="0"/>
                <assign variable="pro2[i]" expression="0"/>
                <assign variable="vect[i]" expression="0"/>
            </for>
            <assign variable="i" expression="0"/>
            <assign variable="cif11" expression="m%10"/>
            <assign variable="cif21" expression="t%10"/>
            <assign variable="cif12" expression="m/10"/>
            <assign variable="cif22" expression="t/10"/>
            <for variable="i" start="0" end="3" direction="inc" step="1">
                <if expression="i==0">
                    <then>
                        <assign variable="sus" expression="(cif11*cif21)+rip"/>
                        <if expression="sus&gt;10 or sus == 10">
                            <then>
                                <assign variable="rip" expression="sus/10"/>
                                <assign variable="val" expression="sus-10*rip"/>
                                <assign variable="pro1[0]" expression="val"/>
                            </then>
                            <else>
                                <assign variable="rip" expression="0"/>
                                <assign variable="pro1[0]" expression="sus"/>
                            </else>
                        </if>
                    </then>
                    <else>
                        <if expression="i==1">
                            <then>
                                <assign variable="sus" expression="(cif12*cif21)+rip"/>
                                <if expression="sus&gt;10 or sus == 10">
                                    <then>
                                        <assign variable="pro1[1]" expression="sus%10"/>
                                        <assign variable="pro1[2]" expression="sus/10"/>
                                    </then>
                                    <else>
                                        <assign variable="pro1[1]" expression="sus"/>
                                    </else>
                                </if>
                                <assign variable="rip" expression="0"/>
                            </then>
                            <else>
                                <if expression="i==2">
                                    <then>
                                        <assign variable="sus" expression="(cif11*cif22)+rip"/>
                                        <if expression="sus&gt;10 or sus == 10">
                                            <then>
                                                <assign variable="rip" expression="sus/10"/>
                                                <assign variable="val" expression="sus-10*rip"/>
                                                <assign variable="pro2[1]" expression="val"/>
                                            </then>
                                            <else>
                                                <assign variable="pro2[1]" expression="sus"/>
                                            </else>
                                        </if>
                                    </then>
                                    <else>
                                        <assign variable="sus" expression="(cif12*cif22)+rip"/>
                                        <if expression="sus&gt;10 or sus == 10">
                                            <then>
                                                <assign variable="pro2[2]" expression="sus%10"/>
                                                <assign variable="pro2[3]" expression="sus/10"/>
                                            </then>
                                            <else>
                                                <assign variable="pro2[2]" expression="sus"/>
                                            </else>
                                        </if>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
            </for>
            <assign variable="rip" expression="0"/>
            <for variable="i" start="0" end="3" direction="inc" step="1">
                <assign variable="somma" expression="pro1[i]+pro2[i]+rip"/>
                <if expression="somma&gt;10 or somma == 10">
                    <then>
                        <assign variable="somma" expression="somma-10"/>
                        <assign variable="rip" expression="1"/>
                    </then>
                    <else>
                        <assign variable="rip" expression="0"/>
                    </else>
                </if>
                <assign variable="vect[i]" expression="somma"/>
            </for>
            <assign variable="vect[3]" expression="vect[3]+rip"/>
            <output expression="&quot;il prodotto vale &quot;" newline="False"/>
            <for variable="i" start="3" end="0" direction="dec" step="1">
                <output expression="vect[i]" newline="False"/>
            </for>
        </body>
    </function>
</flowgorithm>
