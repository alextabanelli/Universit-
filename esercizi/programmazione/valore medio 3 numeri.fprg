    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n, s, m, media" type="Real" array="False" size=""/>
            <output expression="&quot;Dammi il primo numero &quot;" newline="False"/>
            <input variable="n"/>
            <output expression="&quot;Dammi il secondo numero &quot;" newline="False"/>
            <input variable="s"/>
            <output expression="&quot;Dammi il terzo numero &quot;" newline="False"/>
            <input variable="m"/>
            <assign variable="media" expression="(n+s+m)/3"/>
            <output expression="&quot;La media vale &quot;" newline="False"/>
            <output expression="media" newline="True"/>
        </body>
    </function>
