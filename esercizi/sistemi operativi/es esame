int wcount = 0
int processing = 0
semaphore mutex (1)
semaphore waiting (0)

/*
.P significa decremento del semaforo
.V significa aumento del semaforo
.P su un semaforo a 0 blocca il processo fino a quando non viene incrementato da un altro processo
i semafori sono fair, quindi parte il primo che arriva
*/

enter(){
    mutex.P() // protezione variabili condivise
    if !(wcount >= 3 && processing == 0) {
        mutex.V()
        waiting.P()
    }
    wcount--
    processing++
    if (processing < 3) {
        waiting.V()
    }
    else mutex.V()
}


exit(){
    mutex.P()
    processing--
    if (processing == 0 && wcount >= 3) {
        waiting.V()
    }
    else mutex.V()
}


//modo alternativo
int processing = 0
semaphore mutex(1)
q queue of semaphores

enter(){
    mutex.P()
    if (processing == 0 && q.size() >= 2) { // metto 2 perché se ci sono almeno 2 in attesa + il processo che cerca di entrare sono in 3
        semaphore s(0) // variabile automatica
        q.enqueue(s)
        mutex.V()
        s.P()
    }
    else {
        processing = 3
        s = q.dequeue(); s.V()
        s = q.dequeue(); s.V()
        mutex.V()
    }
}

exit(){
    mutex.P()
    processing--
    if (processing == 0 && !q.size() >= 3) {
        processing = 3
        s = q.dequeue(); s.V()
        s = q.dequeue(); s.V()
        s = q.dequeue(); s.V()
    }
    mutex.V()
}