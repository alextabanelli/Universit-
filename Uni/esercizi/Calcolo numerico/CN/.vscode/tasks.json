{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "C/C++: build active file (MinGW)",
			"type": "shell",
			"command": "C:/MinGW/bin/g++",
			"args": [
				"-g",
				"${file}",
				"-o",
				"${fileDirname}/build/Debug/${fileBasenameNoExtension}.exe"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": ["$gcc"],
			"group": "build"
		}
	]
}

