{
  "name": "Session",
  "type": "object",
  "properties": {
    "mnemonic_code": {
      "type": "string",
      "description": "Human-readable join code (e.g., Fenice Rossa)"
    },
    "visit_id": {
      "type": "string",
      "description": "Reference to the visit being conducted"
    },
    "docente_id": {
      "type": "string",
      "description": "ID of the teacher/guide"
    },
    "current_artwork_index": {
      "type": "number",
      "default": 0,
      "description": "Currently active artwork index"
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "active",
        "quiz",
        "completed"
      ],
      "default": "waiting"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of participant user IDs/emails"
    },
    "quiz_enabled": {
      "type": "boolean",
      "default": true
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "mnemonic_code",
    "visit_id"
  ]
}