{
  "name": "Purchase",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "item",
        "visit"
      ],
      "description": "Type of purchased content"
    },
    "item_id": {
      "type": "string",
      "description": "ID of the purchased item or visit"
    },
    "price": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "license": {
      "type": "string"
    },
    "purchase_date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "pending",
        "refunded"
      ],
      "default": "completed"
    }
  },
  "required": [
    "user_email",
    "item_type",
    "item_id"
  ]
}